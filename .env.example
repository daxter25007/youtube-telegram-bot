# Telegram bot credentials (never commit real values)
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_MODE=local
TELEGRAM_LOCAL_API_URL=http://telegram-bot-api:8081

# Comma-separated numeric Telegram user IDs
ADMIN_IDS=

POSTGRES_USER=youtube_bot
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_DB=youtube_bot
DATABASE_URL=postgresql+asyncpg://youtube_bot:change-me-before-production@postgres:5432/youtube_bot

MAX_UPLOAD_MB=1950
MAX_CONCURRENT_DOWNLOADS=3
MAX_DOWNLOADS_PER_USER=1
DOWNLOAD_TIMEOUT_SECONDS=1800
METADATA_TIMEOUT_SECONDS=120

# Internal self-hosted Cobalt API (primary TikTok/Instagram backend)
COBALT_ENABLED=true
COBALT_API_URL=http://cobalt:9000
COBALT_REQUEST_TIMEOUT_SECONDS=30
COBALT_STREAM_TIMEOUT_SECONDS=1800

TEMP_ROOT=/shared-temp/jobs
TEMP_FILE_TTL_HOURS=6
CLEANUP_INTERVAL_SECONDS=3600

RATE_LIMIT_URLS=5
RATE_LIMIT_WINDOW_SECONDS=60
DOWNLOAD_REQUEST_TTL_MINUTES=30
PROGRESS_UPDATE_SECONDS=3

LOG_LEVEL=INFO

# Optional runtime-mounted cookie file, for example /run/secrets/ytdlp_cookies
YTDLP_COOKIES_FILE=
